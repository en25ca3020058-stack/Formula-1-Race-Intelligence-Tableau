<?xml version='1.0' encoding='utf-8' ?>
<workbook source-build='2023.2.0' source-platform='win' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <document-location>
    <document-properties>
      <property name='project-name'>Formula 1 Race Intelligence</property>
      <property name='version'>1.0</property>
      <property name='author'>Race Intelligence Analytics</property>
    </document-properties>
  </document-location>
  <preferences>
    <preference name='ui.encoding.shelf.height' value='24' />
    <preference name='ui.shelf.height' value='26' />
  </preferences>
  <datasources>
    <datasource caption='F1 Race Intelligence (6464 Records)' inline='true' name='federated.f1_dataset' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='f1_race_intelligence_data' name='textscan.f1_data'>
            <connection class='textscan' directory='../Dataset' filename='f1_race_intelligence_data.csv' password='' server='' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.f1_data' name='f1_race_intelligence_data.csv' table='[f1_race_intelligence_data#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US' separator=','>
            <column datatype='integer' name='Race_ID' ordinal='0' />
            <column datatype='integer' name='Season' ordinal='1' />
            <column datatype='integer' name='Round' ordinal='2' />
            <column datatype='string' name='Grand_Prix' ordinal='3' />
            <column datatype='string' name='Circuit_Name' ordinal='4' />
            <column datatype='string' name='Circuit_Type' ordinal='5' />
            <column datatype='string' name='Country' ordinal='6' />
            <column datatype='string' name='Driver_Name' ordinal='7' />
            <column datatype='string' name='Driver_Nationality' ordinal='8' />
            <column datatype='string' name='Constructor_Name' ordinal='9' />
            <column datatype='integer' name='Grid_Position' ordinal='10' />
            <column datatype='string' name='Finishing_Position' ordinal='11' />
            <column datatype='real' name='Points' ordinal='12' />
            <column datatype='string' name='Status' ordinal='13' />
            <column datatype='string' name='DNF_Category' ordinal='14' />
            <column datatype='string' name='Tyre_Compound' ordinal='15' />
            <column datatype='integer' name='Laps_Completed' ordinal='16' />
            <column datatype='integer' name='Podium_Finish' ordinal='17' />
            <column datatype='integer' name='Race_Completion_Flag' ordinal='18' />
          </columns>
        </relation>
        <metadata-records>
          <metadata-record class='column'>
            <remote-name>Race_ID</remote-name>
            <remote-type>20</remote-type>
            <local-name>[Race_ID]</local-name>
            <parent-name>[f1_race_intelligence_data.csv]</parent-name>
            <remote-alias>Race_ID</remote-alias>
            <ordinal>0</ordinal>
            <local-type>integer</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>Season</remote-name>
            <remote-type>20</remote-type>
            <local-name>[Season]</local-name>
            <parent-name>[f1_race_intelligence_data.csv]</parent-name>
            <remote-alias>Season</remote-alias>
            <ordinal>1</ordinal>
            <local-type>integer</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>Grand_Prix</remote-name>
            <remote-type>129</remote-type>
            <local-name>[Grand_Prix]</local-name>
            <parent-name>[f1_race_intelligence_data.csv]</parent-name>
            <remote-alias>Grand_Prix</remote-alias>
            <ordinal>3</ordinal>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <scale>1</scale>
            <width>1073741823</width>
            <contains-null>true</contains-null>
            <collation flag='0' name='LEN_RUS' />
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>Country</remote-name>
            <remote-type>129</remote-type>
            <local-name>[Country]</local-name>
            <parent-name>[f1_race_intelligence_data.csv]</parent-name>
            <remote-alias>Country</remote-alias>
            <ordinal>6</ordinal>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <scale>1</scale>
            <width>1073741823</width>
            <contains-null>true</contains-null>
            <collation flag='0' name='LEN_RUS' />
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>Driver_Name</remote-name>
            <remote-type>129</remote-type>
            <local-name>[Driver_Name]</local-name>
            <parent-name>[f1_race_intelligence_data.csv]</parent-name>
            <remote-alias>Driver_Name</remote-alias>
            <ordinal>7</ordinal>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <scale>1</scale>
            <width>1073741823</width>
            <contains-null>true</contains-null>
            <collation flag='0' name='LEN_RUS' />
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>Constructor_Name</remote-name>
            <remote-type>129</remote-type>
            <local-name>[Constructor_Name]</local-name>
            <parent-name>[f1_race_intelligence_data.csv]</parent-name>
            <remote-alias>Constructor_Name</remote-alias>
            <ordinal>9</ordinal>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <scale>1</scale>
            <width>1073741823</width>
            <contains-null>true</contains-null>
            <collation flag='0' name='LEN_RUS' />
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>Points</remote-name>
            <remote-type>5</remote-type>
            <local-name>[Points]</local-name>
            <parent-name>[f1_race_intelligence_data.csv]</parent-name>
            <remote-alias>Points</remote-alias>
            <ordinal>12</ordinal>
            <local-type>real</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>Status</remote-name>
            <remote-type>129</remote-type>
            <local-name>[Status]</local-name>
            <parent-name>[f1_race_intelligence_data.csv]</parent-name>
            <remote-alias>Status</remote-alias>
            <ordinal>13</ordinal>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <scale>1</scale>
            <width>1073741823</width>
            <contains-null>true</contains-null>
            <collation flag='0' name='LEN_RUS' />
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>DNF_Category</remote-name>
            <remote-type>129</remote-type>
            <local-name>[DNF_Category]</local-name>
            <parent-name>[f1_race_intelligence_data.csv]</parent-name>
            <remote-alias>DNF_Category</remote-alias>
            <ordinal>14</ordinal>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <scale>1</scale>
            <width>1073741823</width>
            <contains-null>true</contains-null>
            <collation flag='0' name='LEN_RUS' />
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>Tyre_Compound</remote-name>
            <remote-type>129</remote-type>
            <local-name>[Tyre_Compound]</local-name>
            <parent-name>[f1_race_intelligence_data.csv]</parent-name>
            <remote-alias>Tyre_Compound</remote-alias>
            <ordinal>15</ordinal>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <scale>1</scale>
            <width>1073741823</width>
            <contains-null>true</contains-null>
            <collation flag='0' name='LEN_RUS' />
          </metadata-record>
        </metadata-records>
      </connection>
      <aliases enabled='yes' />
      <column caption='Reliability Score' datatype='real' name='[Calculation_Reliability]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Race_Completion_Flag]) / COUNT([Race_ID])' />
      </column>
      <column caption='Podium Finish Rate' datatype='real' name='[Calculation_PodiumRate]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Podium_Finish]) / COUNT([Race_ID])' />
      </column>
      <column caption='Cumulative Points' datatype='real' name='[Calculation_CumPoints]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([Points]))' />
      </column>
      <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <layout dim-ordering='alphabetic' dim-percentage='0.5' measure-ordering='alphabetic' measure-percentage='0.5' show-structure='true' />
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='Constructor Points Trajectory'>
      <table>
        <view>
          <datasources>
            <datasource name='federated.f1_dataset' />
          </datasources>
          <datasource-dependencies datasource='federated.f1_dataset'>
            <column datatype='string' name='[Constructor_Name]' role='dimension' type='nominal' />
            <column datatype='real' name='[Points]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Season]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Line' />
            <encodings>
              <color column='[federated.f1_dataset].[Constructor_Name]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.f1_dataset].[sum:Points:qk]</rows>
        <cols>[federated.f1_dataset].[none:Season:ok]</cols>
      </table>
    </worksheet>
    <worksheet name='Tyre Compound vs Circuit Type'>
      <table>
        <view>
          <datasources>
            <datasource name='federated.f1_dataset' />
          </datasources>
          <datasource-dependencies datasource='federated.f1_dataset'>
            <column datatype='string' name='[Circuit_Type]' role='dimension' type='nominal' />
            <column datatype='string' name='[Tyre_Compound]' role='dimension' type='nominal' />
            <column datatype='real' name='[Points]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Square' />
            <encodings>
              <color column='[federated.f1_dataset].[sum:Points:qk]' />
              <text column='[federated.f1_dataset].[sum:Points:qk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.f1_dataset].[none:Circuit_Type:nk]</rows>
        <cols>[federated.f1_dataset].[none:Tyre_Compound:nk]</cols>
      </table>
    </worksheet>
    <worksheet name='Driver Performance Leaderboard'>
      <table>
        <view>
          <datasources>
            <datasource name='federated.f1_dataset' />
          </datasources>
          <datasource-dependencies datasource='federated.f1_dataset'>
            <column datatype='string' name='[Driver_Name]' role='dimension' type='nominal' />
            <column datatype='real' name='[Points]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.f1_dataset].[sum:Points:qk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.f1_dataset].[none:Driver_Name:nk]</rows>
        <cols>[federated.f1_dataset].[sum:Points:qk]</cols>
      </table>
    </worksheet>
    <worksheet name='Grand Prix Host Countries'>
      <table>
        <view>
          <datasources>
            <datasource name='federated.f1_dataset' />
          </datasources>
          <datasource-dependencies datasource='federated.f1_dataset'>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='integer' name='[Race_ID]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <color column='[federated.f1_dataset].[ctd:Race_ID:qk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.f1_dataset].[none:Country:nk]</rows>
        <cols>[federated.f1_dataset].[ctd:Race_ID:qk]</cols>
      </table>
    </worksheet>
    <worksheet name='Driver Reliability Stacked DNF'>
      <table>
        <view>
          <datasources>
            <datasource name='federated.f1_dataset' />
          </datasources>
          <datasource-dependencies datasource='federated.f1_dataset'>
            <column datatype='string' name='[Constructor_Name]' role='dimension' type='nominal' />
            <column datatype='string' name='[DNF_Category]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Race_ID]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.f1_dataset].[none:DNF_Category:nk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.f1_dataset].[none:Constructor_Name:nk]</rows>
        <cols>[federated.f1_dataset].[cnt:Race_ID:qk]</cols>
      </table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name='Dashboard 1 - Team Performance Strategist'>
      <style />
      <size maxheight='800' maxwidth='1200' minheight='800' minwidth='1200' type='fixed' />
      <zones>
        <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='50000' id='2' name='Constructor Points Trajectory' w='100000' x='0' y='0' />
          <zone h='50000' id='3' name='Tyre Compound vs Circuit Type' w='100000' x='0' y='50000' />
        </zone>
      </zones>
    </dashboard>
    <dashboard name='Dashboard 2 - Broadcast Analyst Hub'>
      <style />
      <size maxheight='800' maxwidth='1200' minheight='800' minwidth='1200' type='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='50000' id='5' name='Driver Performance Leaderboard' w='100000' x='0' y='0' />
          <zone h='50000' id='6' name='Grand Prix Host Countries' w='100000' x='0' y='50000' />
        </zone>
      </zones>
    </dashboard>
    <dashboard name='Dashboard 3 - FIA Technical Regulations'>
      <style />
      <size maxheight='800' maxwidth='1200' minheight='800' minwidth='1200' type='fixed' />
      <zones>
        <zone h='100000' id='7' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='100000' id='8' name='Driver Reliability Stacked DNF' w='100000' x='0' y='0' />
        </zone>
      </zones>
    </dashboard>
  </dashboards>
  <windows>
    <window class='worksheet' name='Constructor Points Trajectory' />
    <window class='worksheet' name='Tyre Compound vs Circuit Type' />
    <window class='worksheet' name='Driver Performance Leaderboard' />
    <window class='worksheet' name='Grand Prix Host Countries' />
    <window class='worksheet' name='Driver Reliability Stacked DNF' />
    <window class='dashboard' maximized='true' name='Dashboard 1 - Team Performance Strategist' />
    <window class='dashboard' name='Dashboard 2 - Broadcast Analyst Hub' />
    <window class='dashboard' name='Dashboard 3 - FIA Technical Regulations' />
  </windows>
</workbook>
